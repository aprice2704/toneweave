.inspector-panel {
 min-height: 290px;
}

.preset-grid,
.voice-grid {
 display: grid;
 grid-template-columns: 1fr;
 gap: .4rem;
}

.shift-grid,
.rate-grid {
 display: grid;
 grid-template-columns: repeat(4, 1fr);
 gap: .4rem;
}

.shift-grid .voice-choice,
.rate-grid .voice-choice {
 text-align: center;
 padding-left: .4rem;
 padding-right: .4rem;
}

.color-grid {
 display: grid;
 grid-template-columns: repeat(5, 1fr);
 gap: .35rem;
}

.color-choice {
 min-width: 0;
 padding: .55rem .2rem;
 overflow: hidden;
 text-indent: -9999px;
}

.color-red { background: #df7d7d; }
.color-green { background: #79c99e; }
.color-blue { background: #78a7ff; }
.color-amber { background: #e7ba6c; }
.color-purple { background: #b58cff; }

.color-choice.selected {
 outline: 3px solid #eef2f7;
 outline-offset: -4px;
}

.size-grid {
 display: grid;
 grid-template-columns: repeat(4, 1fr);
 gap: .4rem;
}

.size-grid .voice-choice {
 display: flex;
 flex-direction: column;
 align-items: center;
 justify-content: center;
 gap: .35rem;
 min-width: 0;
 padding: .45rem .2rem;
 font-size: .78rem;
}

.size-dot {
 display: block;
 border-radius: 999px;
 background: #d9dde5;
 flex: 0 0 auto;
}

.node-glyph {
 fill: #eef2f7;
 font-size: 15px;
 font-weight: 650;
 text-anchor: middle;
 pointer-events: none;
}